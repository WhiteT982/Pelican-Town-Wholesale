{
  "Format": "2.9.1",
  "ConfigSchema": {
    "Board Appearance and Location": {
      "AllowValues": "Order Board, Order Stand, Seven Deadly Sins Compatibility",
      "Default": "Order Board",
      "Section": "Appearance and Map Compatibility"
    },
    "Enable Regular Special Orders": {
            "AllowValues": "true, false",
            "Default": "true",
            "Section": "Enable or Disable Orders",
            "Description": "Select true to enable all regular orders accessible through the Order Board/Stand."
        },
        "Enable Festival Orders": {
            "AllowValues": "true, false",
            "Default": "true",
            "Section": "Enable or Disable Orders",
            "Description": "Select true to enable all Festival Orders."
        },
        "Enable Advanced Crafting": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options",
            "Description": "Select true to allow advanced WAG crafting items to be used in special orders."
        },
        "Enable Wild Food": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Cakes": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Muffins": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Cupcakes": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Tarts": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Cookies": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Doughnuts": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Pudding": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Ales": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Coffees": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Teas": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  },
        "Enable Chocolates": {
            "AllowValues": "true, false",
            "Default": "false",
            "Section": "Wildflour Atelier Goods Options"
  }
},
  "Changes": [
    {
      "Action": "Include",
      "FromFile": "Data/specialorders.json, Data/shop.json, Data/mail.json, Data/contexttags.json, Data/events.json, Data/triggers.json, Data/strings.json"
    },
    {
      "When": {
        "HasMod": "Adam.Joja_Machines"
      },
      "Action": "Include",
      "FromFile": "Data/jojamachines.json"
    },
    {
      "When": {
        "HasMod": "FlashShifter.StardewValleyExpandedCP"
      },
      "Action": "Include",
      "FromFile": "Data/SVE.json"
    },
    {
      "When": {
        "HasMod": "Cornucopia.MoreCrops"
      },
      "Action": "Include",
      "FromFile": "Data/Cornucopia.json"
    },
    {
      "When": {
        "HasMod": "Cornucopia.MoreCrops",
        "HasFlag": "Cornucopia.MoreCrops_ExtendedCropsPackEnabled"
      },
      "Action": "Include",
      "FromFile": "Data/CornucopiaExtended.json"
    },
    {
      "When": {
        "HasMod": "Wildflour.AtelierGoods"
      },
      "Action": "Include",
      "FromFile": "Data/WAGbaker.json, Data/WAGale.json, Data/WAGcoffee.json, Data/WAGtea.json, Data/WAGchocolate.json"
    },
    {
      "LogName": "Change to Board",
      "Action": "Include",
      "FromFile": "Data/mappatchesboard.json",
      "When": {
        "Board Appearance and Location": "Order Board",
        "Enable Regular Special Orders": "true"
      }
    },
    {
      "LogName": "Change to Stand",
      "Action": "Include",
      "FromFile": "Data/mappatchesstand.json",
      "When": {
        "Board Appearance and Location": "Order Stand",
        "Enable Regular Special Orders": "true"
      }
    },
    {
      "LogName": "Change to SDS",
      "Action": "Include",
      "FromFile": "Data/mappatchesSDS.json",
      "When": {
        "Board Appearance and Location": "Seven Deadly Sins Compatibility",
        "Enable Regular Special Orders": "true"
      }
    }
]
}